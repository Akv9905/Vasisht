# Environment example — local/free mode by default.
# Copy to .env and adjust. No paid API keys are required.

APP_NAME=Enterprise AI
APP_ENV=development
DEBUG=true

# Local PostgreSQL for persisted analysis snapshots (P4).
DATABASE_URL=postgresql+psycopg://enterprise_ai:enterprise_ai@localhost:5432/enterprise_ai

# Optional LLM — leave disabled for deterministic local mode
LLM_ENABLED=false
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Ingestion
MAX_UPLOAD_BYTES=104857600
EXTRACT_DIR=data/extracts
IGNORE_DIRS=.git,node_modules,target,build,dist,.idea,.vscode,__pycache__,.gradle
